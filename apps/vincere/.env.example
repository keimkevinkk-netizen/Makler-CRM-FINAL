# VINCERE Browser-Konfiguration
# Nur öffentliche/publishable Werte. Niemals Service-Role-, Secret- oder Admin-Schlüssel eintragen.

# local | preview | beta | production
VITE_APP_ENV=local

# demo | live
VITE_DATA_MODE=demo
VITE_APP_VERSION=0.1.0
VITE_RELEASE_SHA=local

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Explizite Freigaben. In Beta/Produktion konservativ auf false lassen, bis Provider geprüft sind.
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_PROVIDER_FUNCTIONS=false
VITE_ENABLE_DEVELOPER_TOOLS=true

# Experimentelle Funktionen müssen sichtbar und einzeln freigegeben werden.
VITE_FEATURE_APPOINTMENTS=false
VITE_FEATURE_VALUATIONS=false
VITE_FEATURE_NETWORK=false
VITE_FEATURE_CONFLICT_RESOLUTION=false
VITE_FEATURE_AI_MOCK_MODE=false
