VITE_APP_ENV=local
VITE_DATA_MODE=demo
VITE_APP_VERSION=0.1.0
VITE_RELEASE_SHA=local

VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_PROVIDER_FUNCTIONS=false
VITE_ENABLE_DEVELOPER_TOOLS=true

# Cloud ist lokal optional. URL und Publishable Key entweder gemeinsam setzen oder beide weglassen.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_FEATURE_APPOINTMENTS=true
VITE_FEATURE_VALUATIONS=true
VITE_FEATURE_NETWORK=true
VITE_FEATURE_CONFLICT_RESOLUTION=true
VITE_FEATURE_AI_MOCK_MODE=false
