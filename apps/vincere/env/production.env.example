VITE_APP_ENV=production
VITE_DATA_MODE=live
VITE_APP_VERSION=0.1.0
VITE_RELEASE_SHA=PRODUCTION_COMMIT_SHA

VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_PROVIDER_FUNCTIONS=false
VITE_ENABLE_DEVELOPER_TOOLS=false

# Erst nach gesonderter Go-live-Freigabe konfigurieren.
VITE_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY

VITE_FEATURE_APPOINTMENTS=false
VITE_FEATURE_VALUATIONS=false
VITE_FEATURE_NETWORK=false
VITE_FEATURE_CONFLICT_RESOLUTION=false
VITE_FEATURE_AI_MOCK_MODE=false
